{
  "name": "html-viewer",
  "version": "1.0.0",
  "description": "Static HTML, CSS and JavaScript editor with live preview",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "dev": "node scripts/local-server.cjs 8000",
    "preview": "node scripts/local-server.cjs 8000 dist --headers",
    "test:dist": "node scripts/verify-dist.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:preview": "node --test tests/preview-lifecycle.e2e.test.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.0"
  }
}
